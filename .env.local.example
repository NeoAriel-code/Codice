# ==============================================================================
# CÓDICE — Variables de Entorno (Local & Producción)
# ==============================================================================

# Supabase (Obligatorias)
# Obtén estos valores en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-supabase-service-role-key

# Anthropic Claude API (Obligatoria para El Oráculo)
# Obtén tu clave en: https://console.anthropic.com/settings/keys
# NUNCA usar prefijo NEXT_PUBLIC_ (solo vive en el servidor)
ANTHROPIC_API_KEY=sk-ant-api03-...
# Opcional: modelo específico de Claude (por defecto: claude-3-7-sonnet-20250219)
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Control de Acceso a la Beta Cerrada (Opcional)
# Si se define, el registro exigirá este código exacto para crear una cuenta.
# Si se deja vacío, el registro es libre.
NEXT_PUBLIC_BETA_INVITE_CODE=CODICE-BETA-2026

# Analítica Web (Opcional)
# Configura PostHog o Plausible para medir la activación y uso del Oráculo
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
